APP_NAME=SecureTS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database ───────────────────────────────────────────────────────────────────
# Local SQLite (quick start):
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Supabase PostgreSQL (team/production):
# DB_CONNECTION=pgsql
# DB_HOST=your-supabase-pooler-host
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.your-project-ref
# DB_PASSWORD=your-supabase-db-password
# DB_SSLMODE=require

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Sanctum token lifetime (minutes). 10080 = 7 days.
SANCTUM_EXPIRATION=10080

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ── Laravel Reverb (WebSocket) ─────────────────────────────────────────────────
# Port 8085, not 8080 — 8080 commonly collides with a local Apache (httpd.exe).
# REVERB_SERVER_PORT is the port `artisan reverb:start` binds to (see the
# `composer dev` script); REVERB_PORT is the port clients connect to.
REVERB_APP_ID=securets
REVERB_APP_KEY=securets-key
REVERB_APP_SECRET=securets-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8085
REVERB_SERVER_PORT=8085
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=file

# ── Stripe (subscriptions) ─────────────────────────────────────────────────────
# Required by config/stripe.php — checkout and the billing portal throw without
# them. Ask your team lead for the test keys and price IDs.
STRIPE_KEY=
STRIPE_SECRET=
# Leave empty in local dev to skip webhook signature verification (see the
# README). Set it when running `stripe listen`.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=
STRIPE_PRICE_ULTRA_PLUS=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
